# SplitApp — copy to .env.local and fill in. NEVER commit .env.local.
# All values come from your Supabase project dashboard.

# Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Settings -> API -> Project API keys -> anon / public
SUPABASE_ANON_KEY=

# Settings -> API -> Project API keys -> service_role (SECRET — bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Settings -> Database -> Connection string -> URI
# Use the "Session pooler" URI if you are on an IPv4-only network (most home ISPs).
# Looks like: postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Percent-encode special characters in the password: @ becomes %40, # becomes %23, etc.
SUPABASE_DB_URL=

# --- Public (browser) ---------------------------------------------------------
# These two are inlined into the client bundle by Next.js. That is safe: the anon
# key is meant to be public and RLS is what protects the data. They must also be
# set in Vercel -> Project -> Settings -> Environment Variables.
#
# NEVER prefix SUPABASE_SERVICE_ROLE_KEY or SUPABASE_DB_URL with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
