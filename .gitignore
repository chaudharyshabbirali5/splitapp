# Secrets — never commit
.env
.env.local
.env.*.local
# ...but the template with no real values IS committed
!.env.local.example

# Dependencies
node_modules/
/.pnp
.pnp.*

# Next.js
# Unanchored so they match inside the frontend/ workspace, not just the repo root.
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Vercel
.vercel

# Supabase CLI local state
# The CLI project moved to database/supabase/, so the old root-anchored patterns
# stopped matching and .temp/ started showing up as untracked. Unanchored now.
**/supabase/.temp/
**/supabase/.branches/

# Claude Code — machine-specific local settings (shared .claude/settings.json is fine)
.claude/settings.local.json

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/coverage
