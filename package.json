{
  "name": "splitapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SplitApp — India-first group expense splitting with real UPI settle-up. Monorepo: frontend/ (Next.js) + database/ (Supabase).",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "db:push": "supabase db push --workdir database",
    "db:diff": "supabase db diff --workdir database",
    "test:acceptance": "tsx database/tests/acceptance-test.ts"
  }
}
